//@version=6
strategy("QM-VWAPDISP-v6", overlay=true, pyramiding=1, process_orders_on_close=true, commission_type=strategy.commission.percent, commission_value=0.05, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100, initial_capital=10000)

lb         = input.int(120, "Equil. lookback (bars)", minval=20, maxval=400)
disp_mult  = input.float(2.0, "Displacement threshold (x ATR)", step=0.1, minval=0.5, maxval=5.0)
avg_dbars  = input.int(8, "Média desejada de barras fora (filtro de continuidade)", minval=1, maxval=30)
cooldown   = input.int(2, "Cooldown after exit (bars)", minval=0, maxval=20)
max_bars   = input.int(50, "Max bars in trade (time exit)", minval=0, maxval=200)
sl_ticks   = input.int(25, "SL ticks", minval=1, maxval=200)
tp_ticks   = input.int(50, "TP ticks", minval=1, maxval=200)

atr = ta.atr(lb)
vwap  = ta.vwap(hlc3)

disp_vwap = math.abs(close - vwap)
band      = disp_mult * atr
outside   = disp_vwap > band

// Controle de continuidade: exigimos que o preço tenha permanecido fora da banda
// por um número mínimo de barras consecutivas, indicando que a displacamento
// não foi apenas ruído de uma barra, mas um deslocamento sustentado.
// sum(outside) nos últimos N bars (com N = avg_dbars+2) conta barras fora.
N_sum = avg_dbars + 2
recent_outs = ta.sum(outside ? 1 : 0, N_sum)
sustained_out = recent_outs >= avg_dbars

// "foi_para_fora" nos últimos 2 barras (para entrada na reversão)
was_out = ta.barssince(outside) <= 2

prev_close = close[1]
body_up    = close > prev_close
body_dn    = close < prev_close

// Entrada: preço voltando para dentro da banda após displacamento sustentado.
long_go = outside == false // currently inside (snapback complete)
        and was_out        // recent outside
        and close >= vwap - band // crossing back (inside band from below)
        and body_up
        and close < vwap
        and sustained_out
        and strategy.position_size == 0

short_go = outside == false
         and was_out
         and close <= vwap + band
         and body_dn
         and close > vwap
         and sustained_out
         and strategy.position_size == 0

if long_go
    strategy.entry("L", strategy.long)
if short_go
    strategy.entry("S", strategy.short)

ltp = close - tp_ticks * syminfo.mintick
lsl = close - sl_ticks * syminfo.mintick
stp = close + tp_ticks * syminfo.mintick
ssl = close + sl_ticks * syminfo.mintick

strategy.exit("LX", from_entry="L", limit=ltp, stop=lsl)
strategy.exit("SX", from_entry="S", limit=stp, stop=ssl)

bars_in_trade = strategy.position_size != 0 ? ta.barssince(strategy.position_size == 0) : 0
if max_bars > 0 and bars_in_trade > max_bars
    if strategy.position_size > 0
        strategy.close("L")
    if strategy.position_size < 0
        strategy.close("S")

plot(vwap, "VWAP", color=color.blue, linewidth=2)
plot(vwap + band, "Banda +", color=color.gray, linewidth=1)
plot(vwap - band, "Banda -", color=color.gray, linewidth=1)
plotshape(long_go, "Long entry", shape.triangleup, location.belowbar, color=color.lime, size=size.tiny)
plotshape(short_go, "Short entry", shape.triangledown, location.abovebar, color=color.red, size=size.tiny)
