//@version=6
strategy("QM-FBR-v2 · FBR + Range Regime Filter (ADX)", 
  overlay=true, 
  pyramiding=1, 
  process_orders_on_close=true, 
  commission_type=strategy.commission.percent, 
  commission_value=0.05, 
  initial_capital=10000, 
  default_qty_type=strategy.percent_of_equity, 
  default_qty_value=100, 
  margin_long=100, 
  margin_short=100)

// === INPUTS ===
lookback    = input.int(20,  "Sweep lookback (bars)")
volLen      = input.int(20,  "ATR ratio smoothing")
volThresh   = input.float(1.5, "Vol ratio threshold (ATR > thresh·SMA → skip)")
adxLen      = input.int(14,  "ADX length")
adxThresh   = input.float(25.0, "ADX max — only trade when ADX < thresh (range regime)")
slBuffer    = input.float(0.5, "SL buffer (×ATR above/below sweep extreme)")
tpMult      = input.float(2.0, "TP multiplier (×ATR)")
maxBars     = input.int(30,  "Max duration (bars) — time exit")
cooldown    = input.int(5,   "Cooldown bars between same-direction entries")

// === SERIES ===
sweepLow  = ta.lowest(low, lookback)
sweepHigh = ta.highest(high, lookback)
atr       = ta.atr(14)
atrRatio  = atr / ta.sma(atr, volLen)

// ADX / DMI
[_, _, adx] = ta.dmi(adxLen, adxLen)

// === FILTERS ===
volOk = atrRatio < volThresh
rangeRegime = adx < adxThresh
regimeOk = volOk and rangeRegime

// === CONDITIONS ===
longCond  = (low <= sweepLow[1]) and (close > sweepLow[1]) and (close > close[1]) and regimeOk
shortCond = (high >= sweepHigh[1]) and (close < sweepHigh[1]) and (close < close[1]) and regimeOk

// === COOLDOWN ===
var int lastLongBar  = na
var int lastShortBar = na
longCooldownOk  = na(lastLongBar)  or (bar_index - lastLongBar  >= cooldown)
shortCooldownOk = na(lastShortBar) or (bar_index - lastShortBar >= cooldown)

// === ENTRIES ===
longEntry  = longCond  and longCooldownOk
shortEntry = shortCond and shortCooldownOk

if longEntry
    strategy.entry("L", strategy.long)
    lastLongBar := bar_index

if shortEntry
    strategy.entry("S", strategy.short)
    lastShortBar := bar_index

// === SL / TP ===
if longEntry
    slPrice = sweepLow[1] - slBuffer * atr
    tpPrice = strategy.position_avg_price + tpMult * atr
    strategy.exit("L_exit", from_entry="L", stop=slPrice, limit=tpPrice)

if shortEntry
    slPrice = sweepHigh[1] + slBuffer * atr
    tpPrice = strategy.position_avg_price - tpMult * atr
    strategy.exit("S_exit", from_entry="S", stop=slPrice, limit=tpPrice)

// === TIME EXIT ===
if strategy.position_size > 0
    if bar_index - lastLongBar >= maxBars
        strategy.close("L")
        lastLongBar := na

if strategy.position_size < 0
    if bar_index - lastShortBar >= maxBars
        strategy.close("S")
        lastShortBar := na

// === PLOTS ===
plot(sweepLow,  "Sweep Low",  color=color.new(color.green, 70), style=plot.style_circles)
plot(sweepHigh, "Sweep High", color=color.new(color.red,   70), style=plot.style_circles)
plot(adx, "ADX", color=color.orange, style=plot.style_line, linewidth=1)
hline(adxThresh, "ADX threshold", color=color.gray, linestyle=hline.style_dashed)
