//@version=6
// EMA 20/50 Cross — Builder refined (hygiene + ATR-based SL/TP)
// Original: disc-ema20-50 (SOLUSDT 4h, Candidate)
// Changes:
//   - commission 0.05% (MCP parity, was 0)
//   - SL/TP from ATR ticks instead of fixed % of avg price
//   - signal plots for diagnostics
//   - inputs: atrLen, slMult, tpMult replace slPct/tpPct
// No trailing. No repaint. No lookahead. MCP RULE compliant.

strategy(
  "EMA 20/50 Cross (ATR SL/TP) [builder-refined]",
  overlay=true,
  pyramiding=1,
  process_orders_on_close=true,
  commission_type=strategy.commission.percent,
  commission_value=0.05,
  initial_capital=10000,
  default_qty_type=strategy.percent_of_equity,
  default_qty_value=100,
  margin_long=100,
  margin_short=100
)

// ---------- inputs ----------
fastLen   = input.int(20, "Fast EMA", minval=2)
slowLen   = input.int(50, "Slow EMA", minval=2)
atrLen    = input.int(14, "ATR length", minval=1)
slMult    = input.float(2.0, "SL multiple of ATR", step=0.1, minval=0.1)
tpMult    = input.float(4.0, "TP multiple of ATR", step=0.1, minval=0.1)

// ---------- indicators ----------
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
atrVal  = ta.atr(atrLen)
tickSz  = syminfo.mintick

// ---------- signal ----------
longSig  = ta.crossover(fastEma, slowEma)
shortSig = ta.crossunder(fastEma, slowEma)

// ---------- SL/TP in ticks ----------
slTicks = atrVal > 0 and tickSz > 0 ? math.max(1, math.round(slMult * atrVal / tickSz)) : 10
tpTicks = atrVal > 0 and tickSz > 0 ? math.max(1, math.round(tpMult * atrVal / tickSz)) : 20

// ---------- entries ----------
if longSig and strategy.position_size == 0
    strategy.entry("L", strategy.long)

if shortSig and strategy.position_size == 0
    strategy.entry("S", strategy.short)

// ---------- exits (ATR-based, no trailing) ----------
if strategy.position_size > 0
    strategy.exit("Lx", from_entry="L", loss=slTicks, profit=tpTicks)

if strategy.position_size < 0
    strategy.exit("Sx", from_entry="S", loss=slTicks, profit=tpTicks)

// ---------- plots ----------
plot(fastEma, "Fast EMA", color=color.teal, linewidth=1)
plot(slowEma, "Slow EMA", color=color.maroon, linewidth=1)
plot(longSig, "longSig", color.new(color.green, 0), style=plot.style_circles, linewidth=2)
plot(shortSig, "shortSig", color.new(color.red, 0), style=plot.style_circles, linewidth=2)
