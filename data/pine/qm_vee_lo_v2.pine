//@version=6
// QM-VEE-LO-v2 - Pure Long Breakout Continuation (v2: fixed signal logic)
// -------------------------------------------------------------------------
// Hypothesis: crypto markets have upward bias. A low-level breakout confirmed
// by a follow-through close has positive expectancy. Short-side follow-through
// is contrarian and excluded.
// DNA: long-only, breakout + close confirmation, SL/TP fixed ATR, no trailing.

strategy(
  title  = "QM-VEE-LO-v2 - Pure Long Breakout Continuation",
  overlay = true,
  pyramiding = 1,
  process_orders_on_close = true,
  commission_type = strategy.commission.percent,
  commission_value = 0.05,
  initial_capital = 10000,
  default_qty_type = strategy.percent_of_equity,
  default_qty_value = 100,
  margin_long = 100,
  margin_short = 100
)

// --- Inputs ----------------------------------------------
sweepNbars   = input.int(15, "Sweep lookback (recent highs)", minval=5, maxval=40, step=1)
breakPct     = input.float(0.005, "Min close above recent high (% of high)", minval=0.0, maxval=0.03, step=0.0005)
minVol       = input.float(0.70, "Min volume relative to SMA volume", minval=0.1, maxval=3.0, step=0.05)
slMult       = input.float(2.0, "SL multiplier x ATR from entry", minval=0.5, step=0.1)
tpMult       = input.float(1.5, "TP multiplier x ATR from entry", minval=0.5, step=0.1)
maxBars      = input.int(25, "Max bars in trade (time exit)", minval=5, step=5)
useVolFilter = input.bool(true, "Require volume above threshold")
// -------------------------------------------------------

// --- Series ----------------------------------------------
atr      = ta.atr(14)
smaVol   = ta.sma(volume, 20)
swHigh   = ta.highest(high[2], sweepNbars)   // highest high before bar[1] (not including bar[1])
valid    = not na(atr) and not na(smaVol)

// --- Signal: bar[1] broke recent high AND closed above it ----
// (follow-through: close above the level that high touched)
breakOut   = valid and high[1] > swHigh
followThru = valid and close[1] > swHigh + (swHigh * breakPct)
volOk      = useVolFilter ? (volume[1] >= smaVol[1] * minVol) : true

longSignal = breakOut and followThru and volOk and strategy.position_size == 0

// --- Entry -------------------------------------------------
if longSignal
    strategy.entry("L", strategy.long)

// --- SL / TP (fixed ATR multiples, reissued each bar) -----
if strategy.position_size > 0
    slPrice = strategy.position_avg_price - slMult * atr
    tpPrice = strategy.position_avg_price + tpMult * atr
    strategy.exit("L-SL", from_entry="L", stop=slPrice, limit=tpPrice)

// --- Time exit --------------------------------------------
var int barsInTrade = 0
if strategy.position_size != 0
    barsInTrade := barsInTrade + 1
else
    barsInTrade := 0

if barsInTrade >= maxBars and strategy.position_size > 0
    strategy.close("L")

// --- Plots ------------------------------------------------
plotshape(longSignal, title="Long Breakout", style=shape.triangleup,
          location=location.belowbar, color=color.lime, size=size.small)
plot(swHigh, "Recent High (prior)", color=color.gray, linewidth=1, style=plot.style_dashed)
